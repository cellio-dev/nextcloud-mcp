# Nextcloud instance (no trailing slash)
NEXTCLOUD_URL=https://cloud.example.com

# MCP logs in as this Deck user (dedicated agent account recommended)
NEXTCLOUD_USERNAME=cursor
NEXTCLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Bearer token for /mcp and /watch/* (not "Bearer " prefix — raw token only)
MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

PORT=3000
HOST=0.0.0.0

# Optional: restrict file tools to a subdirectory
# NEXTCLOUD_FILES_ROOT=Projects
# NEXTCLOUD_MAX_READ_BYTES=1048576

# --- Deck watcher (recommended: comment-only, quiet thread) ---
DECK_WATCH_ENABLED=true
DECK_WATCH_AGENT_USER=cursor
# Nextcloud login uid (email is fine — use the uid, not display name, for Deck APIs)
DECK_WATCH_OWNER_USER=your-username
DECK_WATCH_INTERVAL_SEC=60
DECK_WATCH_STATE_PATH=/data/deck-watch-state.json

# Triggers: @cursor comments only (no assign-to-cursor queue)
DECK_WATCH_COMMENT_TRIGGER=true
DECK_WATCH_COMMENT_MENTION=@cursor
DECK_WATCH_ASSIGNMENT_TRIGGER=false

# Quiet thread: one agent reply via deck_add_comment, not a stack of acks
DECK_WATCH_AUTO_ACK=false
DECK_WATCH_SILENT_CLAIM=true
DECK_WATCH_POST_DONE_COMMENT=false
DECK_WATCH_COMPLETE_UNASSIGN_AGENT=false
DECK_WATCH_COMPLETE_ASSIGN_OWNER=false
DECK_WATCH_AUTO_MENTION_REPLY=true
DECK_WATCH_ONE_REPLY_PER_JOB=true

# Optional: limit boards (comma-separated ids)
# DECK_WATCH_BOARD_IDS=10

# Cursor Automation webhook (required for automatic replies without chat)
# DECK_WATCH_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
# DECK_WATCH_WEBHOOK_TOKEN=YOUR_WEBHOOK_API_KEY

# --- Alternate: assign-to-cursor inbox + hand back on complete ---
# DECK_WATCH_ASSIGNMENT_TRIGGER=true
# DECK_WATCH_COMPLETE_UNASSIGN_AGENT=true
# DECK_WATCH_COMPLETE_ASSIGN_OWNER=true