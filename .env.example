# Nextcloud instance (no trailing slash)
NEXTCLOUD_URL=https://cloud.example.com

# Nextcloud username
NEXTCLOUD_USERNAME=your-username

# App password from Nextcloud → Personal settings → Security
# Do NOT use your account password when 2FA is enabled.
NEXTCLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Bearer token required by Cursor/clients to call this MCP server over HTTP.
# Generate a long random string, e.g. openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# HTTP listen settings (ignored in --stdio mode)
PORT=3000
HOST=0.0.0.0

# Optional: restrict file tools to a subdirectory under the user's Files root
# NEXTCLOUD_FILES_ROOT=Projects

# Optional: max bytes returned by files_read (default 1 MiB)
# NEXTCLOUD_MAX_READ_BYTES=1048576

# --- Deck watcher (optional) ---
# Polls Deck for cards assigned to the agent user, queues them, optional webhook.
# DECK_WATCH_ENABLED=true
# DECK_WATCH_AGENT_USER=cursor
# DECK_WATCH_OWNER_USER=your-username
# DECK_WATCH_BOARD_IDS=1
# DECK_WATCH_INTERVAL_SEC=60
# DECK_WATCH_STATE_PATH=/data/deck-watch-state.json
# DECK_WATCH_AUTO_ACK=true
# Comment collaboration: poll for mentions and wake via webhook
# DECK_WATCH_COMMENT_TRIGGER=true
# DECK_WATCH_COMMENT_MENTION=@cursor
# Cursor Automation webhook (https://cursor.com/automations → Webhook trigger):
# DECK_WATCH_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
# DECK_WATCH_WEBHOOK_TOKEN=YOUR_WEBHOOK_API_KEY
